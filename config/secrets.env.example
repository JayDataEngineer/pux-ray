# Tech Noir Infrastructure Secrets
# ================================
# Copy to secrets.env and fill in values.
# Sync to k8s: task secrets:sync
#
# This is the SINGLE source of truth for all secrets.
# The sync script creates a 'shared-infra' k8s secret in every namespace.

# Postgres — shared database (infra namespace)
POSTGRES_PASSWORD=change-me

# Garage S3 — object storage (infra namespace)
GARAGE_RPC_SECRET=
GARAGE_S3_ACCESS_KEY=
GARAGE_S3_SECRET_KEY=

# Langfuse — LLM observability (infra namespace)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SALT=
LANGFUSE_DB_URL=

# Infisical — secrets management (infra namespace)
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_CONNECTION_URI=
INFISICAL_POSTGRES_PASSWORD=

# Gitea — self-hosted Git server (git namespace)
GITEA_ADMIN_PASSWORD=

# Renovate — dependency automation (git namespace)
RENOVATE_TOKEN=
GH_PAT=
