# K3s containerd registry mirror configuration
#
# Maps "forge-reg.local:30500" to the Forge Registry NodePort.
# Containerd requires a dotted hostname (forge-reg won't work —
# it gets treated as a docker.io namespace).
#
# Setup:
#   sudo mkdir -p /etc/rancher/k3s
#   sudo cp config/registries.yaml.example /etc/rancher/k3s/registries.yaml
#   sudo systemctl restart k3s
#
# Verify:
#   sudo k3s crictl pull forge-reg.local:30500/tech-noir/gpu-all:latest

mirrors:
  "forge-reg.local:30500":
    endpoint:
      - "http://forge-reg.local:30500"
