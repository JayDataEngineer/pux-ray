# Tech Noir Unified GPU Worker — ALL services in ONE image.
# Wan2GP base (CUDA 12.8 + PyTorch 2.10+cu128) replaces NGC PyTorch.
# Every GPU service (TTS, ASR, 3D, music, vision, creative, image) lives here.
#
# Build:
#   docker bake gpu-all --push

# ── Stage 1a: Build BeeLlama.cpp with CUDA 12.8 ────────────────────────
# BeeLlama.cpp = llama.cpp fork with DFlash speculative decoding, TurboQuant/TCQ KV cache,
# adaptive draft-max, and reasoning-loop protection.
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04 AS beellama-builder
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/Anbeeld/beellama.cpp.git /tmp/beellama && \
    cd /tmp/beellama && \
    cmake -B build -DGGML_CUDA=ON -DGGML_NATIVE=ON \
        -DGGML_CUDA_FA=ON -DGGML_CUDA_FA_ALL_QUANTS=ON \
        -DLLAMA_CURL=OFF -DLLAMA_BUILD_EXAMPLES=OFF \
        -DCMAKE_CUDA_ARCHITECTURES=89 \
        -DCMAKE_CXX_STANDARD_LIBRARIES="-lcuda" \
        -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" \
        -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" && \
    cmake --build build -j$(nproc) --target llama-server llama-cli

# ── Stage 1b: Build upstream llama.cpp with CUDA 12.8 ──────────────────
# Stable upstream release, no DFlash. Installed as ``llama-server-upstream``
# so both binaries coexist in the final image.
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04 AS upstream-builder
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp.git /tmp/upstream && \
    cd /tmp/upstream && \
    cmake -B build -DGGML_CUDA=ON -DGGML_NATIVE=ON \
        -DGGML_CUDA_FA=ON \
        -DLLAMA_CURL=OFF -DLLAMA_BUILD_EXAMPLES=OFF \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_CUDA_ARCHITECTURES=89 \
        -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" && \
    cmake --build build -j$(nproc) --target llama-server

# ── Stage 2: Wan2GP base (replicate Wan2GP Dockerfile with uv) ────────
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04 AS wan2gp-base

# uv for fast installs
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1

ARG CUDA_ARCHITECTURES="8.9"
ARG MAX_JOBS=4
ENV DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST="${CUDA_ARCHITECTURES}" \
    FORCE_CUDA=1 \
    MAX_JOBS=${MAX_JOBS}

# System deps (from Wan2GP Dockerfile)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip git wget curl cmake ninja-build \
    libgl1 libglib2.0-0 ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Install PyTorch with CUDA 12.8 via uv (faster than pip)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    torch==2.10.0+cu128 torchvision==0.25.0+cu128 torchaudio==2.10.0+cu128 \
    --index-url https://download.pytorch.org/whl/cu128

# Wan2GP requirements from our fork — covers mmgp, transformers, diffusers, spacy,
# misaki, insightface, speechbrain, gradio, opencv, decord, timm, gguf, etc.
COPY opt/wan2gp/requirements.txt /tmp/wan2gp-requirements.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --index-strategy unsafe-best-match -r /tmp/wan2gp-requirements.txt

# SageAttention from source (patch GPU detection for CUDA_ARCH override)
RUN git clone https://github.com/thu-ml/SageAttention.git /tmp/sageattention
COPY infra/docker/patch_sageattention.py /tmp/patch_sageattention.py
RUN cd /tmp/sageattention && \
    python3 /tmp/patch_sageattention.py && \
    uv pip install --no-build-isolation . && \
    rm -rf /tmp/sageattention /tmp/patch_sageattention.py

# ── Stage 3: Final image — add Ray + our extras on top of Wan2GP base ──
FROM wan2gp-base

ARG MAX_JOBS=4

# Extra system packages (beyond Wan2GP base)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git-lfs pkg-config build-essential \
    libsm6 libxext6 libxrender-dev \
    libjpeg-dev libspatialindex-dev libsndfile1 \
    mecab libmecab-dev espeak-ng \
    sox libsox-dev libsox-fmt-all && \
    rm -rf /var/lib/apt/lists/*

# ── Ray (must install before CUDA extensions so they link to this torch) ──
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "ray[serve]==2.55.1"

# ── Flash attention ──────────────────────────────────────────────────────
# Build from source to match PyTorch 2.10 ABI (~30min, only runs on image rebuild).
# vllm-flash-attn removed — ABI mismatch (undefined symbol errors).
RUN --mount=type=cache,target=/root/.cache/uv \
    MAX_JOBS=${MAX_JOBS} uv pip install flash-attn --no-build-isolation


# ── Extra Python packages (NOT in Wan2GP requirements) ────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    phonemizer faster-whisper faster-qwen3-tts \
    safetensors kornia mediapipe \
    scikit-image scikit-learn \
    trimesh lpips plyfile pygltflib pyvista pymeshfix xatlas rtree igraph \
    h5py pandas \
    starlette aiohttp httpx \
    openai huggingface-hub \
    pyyaml click rich \
    "protobuf>=6,<7" packaging webcolors

# natten needs build isolation off to see system torch
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install natten==0.21.0 --no-build-isolation

# qwen-tts (no-deps to avoid accelerate version conflict)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps qwen-tts

# ── CUDA extensions (source builds — torch ABI must match) ────────────

# nvdiffrast (CUDA rasterizer, ~10min)
RUN MAX_JOBS=${MAX_JOBS} git clone --depth 1 https://github.com/NVlabs/nvdiffrast.git /tmp/nvdiffrast && \
    cd /tmp/nvdiffrast && \
    MAX_JOBS=${MAX_JOBS} uv pip install . --no-build-isolation && \
    rm -rf /tmp/nvdiffrast

# TRELLIS.2 CUDA dependencies — CuMesh, FlexGEMM, o-voxel
RUN MAX_JOBS=${MAX_JOBS} git clone --depth 1 --recursive https://github.com/JeffreyXiang/CuMesh.git /tmp/cumesh && \
    cd /tmp/cumesh && \
    MAX_JOBS=${MAX_JOBS} uv pip install . --no-build-isolation && \
    rm -rf /tmp/cumesh

RUN MAX_JOBS=${MAX_JOBS} git clone --depth 1 --recursive https://github.com/JeffreyXiang/FlexGEMM.git /tmp/flexgemm && \
    cd /tmp/flexgemm && \
    MAX_JOBS=${MAX_JOBS} uv pip install . --no-build-isolation && \
    rm -rf /tmp/flexgemm

COPY vendor/o-voxel/ /tmp/o-voxel/
RUN cd /tmp/o-voxel && \
    MAX_JOBS=${MAX_JOBS} uv pip install . --no-build-isolation && \
    rm -rf /tmp/o-voxel

# nvdiffrec (PBR rendering for TRELLIS)
RUN MAX_JOBS=${MAX_JOBS} git clone -b renderutils --depth 1 \
        https://github.com/JeffreyXiang/nvdiffrec.git /tmp/extensions/nvdiffrec && \
    MAX_JOBS=${MAX_JOBS} uv pip install /tmp/extensions/nvdiffrec --no-build-isolation && \
    rm -rf /tmp/extensions/nvdiffrec

# pytorch3d (for AniGen)
RUN --mount=type=cache,target=/root/.cache/uv \
    MAX_JOBS=${MAX_JOBS} git clone --depth 1 https://github.com/facebookresearch/pytorch3d.git /tmp/pytorch3d && \
    cd /tmp/pytorch3d && \
    MAX_JOBS=${MAX_JOBS} uv pip install --no-build-isolation . && \
    rm -rf /tmp/pytorch3d

# spconv (source build for CUDA 12.8 — needs FORCE_CUDA=1)
RUN --mount=type=cache,target=/root/.cache/uv \
    FORCE_CUDA=1 SPCONV_CUDA_ARCHITECTURES=8.9 MAX_JOBS=${MAX_JOBS} \
    uv pip install spconv --no-build-isolation

# ── Clone git repos (for services that need full repo structure) ──────
WORKDIR /opt

# ComfyUI (must stay subprocess — node-based server)
RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI

# IndexTTS — copy package to site-packages (no heavy build deps)
RUN GIT_LFS_SKIP_SMUDGE=1 git clone --depth 1 https://github.com/index-tts/index-tts.git /tmp/index-tts && \
    cp -r /tmp/index-tts/indextts $(python3 -c "import site; print(site.getsitepackages()[0])")/ && \
    rm -rf /tmp/index-tts

# HY-Motion (git-lfs for stats/)
RUN git clone --depth 1 https://github.com/Tencent-Hunyuan/HY-Motion-1.0.git /opt/hymotion && \
    cd /opt/hymotion && git lfs pull

# See-Through (needs common/ + inference/ + annotators/ for internal imports)
RUN git clone --depth 1 https://github.com/shitagaki-lab/see-through.git /opt/seethrough

# vibevoice.cpp (C++ GGML inference for VibeVoice TTS + ASR — quantized GGUF models)
# Build CPU-only; CUDA backend needs dev libs not in golden image
RUN git clone --recursive --depth 1 https://github.com/localai-org/vibevoice.cpp.git /tmp/vv-cpp && \
    cd /tmp/vv-cpp && cmake -B build && cmake --build build -j$(nproc) && \
    cp build/bin/vibevoice-cli /usr/local/bin/ && \
    (cp build/bin/vibevoice-quantize /usr/local/bin/ || true) && \
    find build -name "*.so*" -exec cp {} /usr/local/lib/ \; && \
    ldconfig && \
    rm -rf /tmp/vv-cpp

# llama.cpp — copy both binaries from their builder stages
COPY --from=beellama-builder /tmp/beellama/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=beellama-builder /tmp/beellama/build/bin/llama-cli /usr/local/bin/llama-cli
COPY --from=beellama-builder /tmp/beellama/build/bin/lib* /usr/local/lib/
COPY --from=upstream-builder /tmp/upstream/build/bin/llama-server /usr/local/bin/llama-server-upstream
RUN ldconfig

# ── ACE-Step deps (from copied requirements, filtered) ──────────────────
COPY vendor/acestep-requirements.txt /tmp/acestep-reqs.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    grep -v -i -E '^(torch|torchvision|torchaudio|xformers|flash-attn)' \
        /tmp/acestep-reqs.txt > /tmp/reqs_acestep.txt && \
    uv pip install -r /tmp/reqs_acestep.txt || true && rm /tmp/reqs_acestep.txt

# ── See-Through deps (filtered) ─────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /opt/seethrough && \
    grep -v -i -E '^(torch|torchvision|torchaudio|xformers|flash-attn|-e )' requirements.txt | \
    grep -v -E 'PyQt|qtpy|natsort|py7zr|ipykernel|Cython|pytest' > /tmp/reqs_seethrough.txt && \
    uv pip install -r /tmp/reqs_seethrough.txt || true && \
    uv pip install ./common ./annotators || true && rm /tmp/reqs_seethrough.txt

# ── Wan2GP fork (our custom models registered as native families) ────────
COPY opt/wan2gp/ /opt/wan2gp/

# TRELLIS.2 trellis2 package lives inside the Wan2GP fork at
# opt/wan2gp/models/trellis/trellis2/ — with sage attention built-in.
# The handler adds its own directory to sys.path at load time.

# AniGen — stripped inference code (no training, no datasets)
COPY vendor/anigen/ /opt/anigen/anigen/
COPY vendor/anigen-configs/ /opt/anigen/configs/

# ACE-Step — stripped music generation code (no auto-downloads, no UI)
COPY vendor/acestep/ /opt/acestep/acestep/

# utils3d — pinned commit for trellis2 + anigen compatibility
RUN git clone https://github.com/EasternJournalist/utils3d.git /opt/utils3d && \
    cd /opt/utils3d && \
    git checkout 9a4eb15e4021b67b12c460c7057d642626897ec8

# ── ComfyUI deps (filtered) ─────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    grep -v -E "^(torch==|torchvision==|torchaudio|xformers|flash-attn)" \
        /opt/ComfyUI/requirements.txt > /tmp/reqs_comfyui.txt && \
    uv pip install -r /tmp/reqs_comfyui.txt && rm /tmp/reqs_comfyui.txt

# ── ComfyUI extensions ──────────────────────────────────────────────────
COPY config/comfyui_extensions.yaml /tmp/extensions.yaml
COPY infra/docker/setup_comfyui.py /tmp/setup_comfyui.py
RUN python3 /tmp/setup_comfyui.py && rm /tmp/setup_comfyui.py /tmp/extensions.yaml

# ── TRELLIS runtime patches (flex_gemm conv + cumesh fallback) ──
COPY infra/docker/patch_conv_flex_gemm.py /opt/patch_conv_flex_gemm.py
COPY infra/docker/patch_cumesh_fallback.py /opt/patch_cumesh_fallback.py

# ── API wrappers (only for services still using subprocess) ────────────
COPY infra/docker/api_hymotion.py /opt/hymotion/api.py
COPY infra/docker/api_qwen_tts.py /opt/api_qwen_tts.py
COPY infra/docker/api_vibevoice.py /opt/api_vibevoice.py
COPY infra/docker/api_trellis_spz.py /opt/api_trellis_spz.py

# ── Project code ────────────────────────────────────────────────────────
COPY vendor/ /opt/vendor/
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY sdk/ /app/sdk/
COPY pyproject.toml /app/
COPY infra/k8s/serve_config.py /app/serve_config.py
COPY infra/k8s/serve_deploy.py /app/serve_deploy.py

WORKDIR /app

# ── Final version pins ───────────────────────────────────────────────────
# Upgrade transformers from Wan2GP's 4.54.0 — some services need 4.57.x
RUN uv pip install \
    "protobuf>=6,<7" \
    transformers==4.57.3 tokenizers==0.22.2

# thinc Cython ext must be rebuilt against final numpy (pip installs may pull
# numpy 2.x after thinc was compiled against 1.x headers → dtype size mismatch)
RUN uv pip install --no-cache-dir --force-reinstall thinc

# ── spconv pre-warm (bakes JIT kernel cache into image, avoids 10+ min cold start) ──
RUN python3 -c "import spconv; print(f'spconv {spconv.__version__} pre-warmed')" || \
    echo "spconv pre-warm skipped (needs GPU at runtime)"

# ── Env defaults (overridden per-deployment) ────────────────────────────
ENV PYTHONPATH=/app:/opt/wan2gp:/opt/utils3d:/opt/hymotion:/opt/anigen:/opt/seethrough:/opt/vendor \
    HF_HOME=/tmp/huggingface \
    HF_HUB_CACHE=/tmp/huggingface \
    ATTN_BACKEND=flash_attn

# ── Verify ──────────────────────────────────────────────────────────────
RUN python3 -c "import torch; print(f'torch {torch.__version__}, CUDA {torch.cuda.is_available()}')" && \
    python3 -c "import torchaudio; print(f'torchaudio {torchaudio.__version__}')" && \
    python3 -c "import ray; print(f'ray {ray.__version__}')" && \
    python3 -c "import transformers; print(f'transformers {transformers.__version__}')" && \
    python3 -c "import google.protobuf; print(f'protobuf {google.protobuf.__version__}')" && \
    python3 -c "import nvdiffrast; print('nvdiffrast OK')" && \
    python3 -c "import pytorch3d; print('pytorch3d OK')" && \
    python3 -c "import sys; sys.path.insert(0, '/opt/wan2gp/models/trellis'); import trellis2; print('trellis2 OK')" && \
    python3 -c "from models.trellis.trellis_handler import family_handler; print(f'TRELLIS handler OK: {family_handler.query_supported_types()}')" && \
    python3 -c "from models.pixal3d.pixal3d_handler import family_handler; print(f'Pixal3D handler OK: {family_handler.query_supported_types()}')" && \
    echo "gpu-all image verification passed"
