# Dockerfile.vace — Standalone Wan VACE video service via DiffSynth-Studio
#
# Bypasses SGLang (VCU inputs unsupported by SGLang's compiled diffusion graph).
# DiffSynth-Studio provides native VACE pipeline + TeaCache + tiled VAE +
# AutoWrappedModule (mmGP-equivalent block-level VRAM streaming).
#
# Pattern mirrors Dockerfile.moss: standalone container, stdlib http.server,
# called via forge_vace.py adapter. One request at a time per container
# (Python GIL — scale horizontally for concurrency, not vertically).
#
# Base image: tech-noir/gpu-all:natten-0.21.5 — already has CUDA 12.8 +
# PyTorch cu128 + flash-attn. We only add DiffSynth-Studio + SageAttention.
FROM forge-reg.local:30500/tech-noir/gpu-all:natten-0.21.5

LABEL description="Wan VACE video service — DiffSynth-Studio (TeaCache + SageAttention)"

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1

# ffmpeg for video encode/decode, fonts for any PIL rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# SageAttention + Flash-Attn 2.8.3 already baked into the gpu-all base image
# (sageattention at /usr/local/lib/python3.10/dist-packages/sageattention/).
# Pin the override env so DiffSynth's attention selector picks Sage at import
# time — falls through to FA2 → torch SDPA if Sage ever goes missing.
ARG TORCH_CUDA_ARCH_LIST="8.9"
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}

# DiffSynth-Studio — VACE pipeline + TeaCache + AutoWrappedModule VRAM mgmt.
# Try PyPI first (faster); fall back to git main if the PyPI build is stale
# relative to a fresh VACE-Fun-A14B example or VRAM-management fix.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    "diffsynth" \
    "modelscope" \
    "imageio[ffmpeg]" \
    "einops" \
    || uv pip install \
    "git+https://github.com/modelscope/DiffSynth-Studio.git" \
    "modelscope" \
    "imageio[ffmpeg]" \
    "einops"

# VACE server + forge adapter
COPY services/video/vace_server.py /app/vace_server.py
COPY services/video/forge_vace.py /app/forge_vace.py

# Runtime env defaults — tunable via k8s manifest
ENV VACE_PORT=8082
ENV VACE_MODELS_ROOT=/models/video
ENV VACE_TOKENIZER_ROOT=/models/video/wan-vace-tokenizer
# Optimization defaults calibrated for RTX 4090 24GB
ENV VACE_FP8=0
ENV VACE_TEACACHE_THRESH=0.15
ENV VACE_TEACACHE_MODEL_ID=Wan2.1-T2V-14B
ENV VACE_ATTENTION=
ENV VACE_VRAM_LIMIT_GB=0
ENV VACE_TILED=1
ENV VACE_TILE_SIZE=30,52
ENV VACE_DEFAULT_STEPS=18
# Stable diffusion libs
ENV SAFETENSORS_DISABLE_MMAP=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

EXPOSE 8082
CMD ["python3", "/app/vace_server.py"]
