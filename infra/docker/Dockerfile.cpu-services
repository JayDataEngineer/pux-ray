# Tech Noir CPU Services — Kokoro TTS + Faster-Whisper ASR + eSpeak.
# Lightweight image, no CUDA needed. For use as k8s Deployment
# or as a KubeRay CPU worker group.
#
# Build:
#   podman build -f infra/docker/Dockerfile.cpu-services -t tech-noir/cpu-services:latest .

FROM docker.io/library/python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1

# System deps: espeak-ng for TTS, ffmpeg/libav for audio
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        espeak-ng ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# uv for fast package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1

# Install Python dependencies (pinned for compatibility)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        ray[serve]==2.55.1 \
        httpx pyyaml pydantic starlette python-multipart uvicorn \
        "numpy<2" \
        kokoro "misaki[en]" soundfile phonemizer \
        faster-whisper

# Copy project code
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY sdk/ /app/sdk/
COPY pyproject.toml /app/
COPY infra/k8s/serve_config.py /app/serve_config.py

WORKDIR /app

# Verify
RUN python3 -c "import kokoro; print('kokoro ok')" && \
    python3 -c "import faster_whisper; print('faster-whisper ok')" && \
    which espeak-ng
