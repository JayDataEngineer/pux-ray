# GPT-SoVITS — Voice Cloning TTS Docker image for Ray Serve
# =============================================================================
# Build:
#   docker build -f infra/docker/Dockerfile.gptsovits -t tech-noir/gptsovits:latest .
#
# Base: CUDA 12.6 runtime
# Models mounted at /models/audio/gpt-sovits (host models_root/audio/gpt-sovits)
FROM nvidia/cuda:12.6.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-dev python3.10-venv python3-pip \
    build-essential git curl \
    libsndfile1 libsndfile1-dev ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

WORKDIR /opt
RUN git clone --depth 1 https://github.com/RVC-Boss/GPT-SoVITS.git gpt-sovits
WORKDIR /opt/gpt-sovits

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126 && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir fastapi uvicorn python-multipart

COPY infra/docker/api_gptsovits.py /opt/api.py

EXPOSE 8000
CMD ["python", "/opt/api.py"]
