# GPT-SoVITS — Voice Cloning TTS Docker image for Ray Serve
# Inherits from ray-base (torch + ray + flash-attn + common libs)
# Build:
#   podman build -f infra/docker/Dockerfile.gptsovits -t tech-noir/gptsovits:latest .
FROM tech-noir/ray-base:latest

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone --depth 1 https://github.com/RVC-Boss/GPT-SoVITS.git gpt-sovits
WORKDIR /opt/gpt-sovits

# Install deps — torch/fastapi/uvicorn already in base
RUN --mount=type=cache,target=/root/.cache/uv \
    grep -v -i -E '^(torch|torchvision|torchaudio|xformers|flash-attn)' requirements.txt > /tmp/reqs_filtered.txt && \
    uv pip install -r /tmp/reqs_filtered.txt

COPY infra/docker/api_gptsovits.py /opt/api.py

# Ray Serve project code
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY infra/k8s/serve_config.py /app/serve_config.py
WORKDIR /app
ENV PYTHONPATH=/app

EXPOSE 8000
CMD ["python", "/opt/api.py"]
