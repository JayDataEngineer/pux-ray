# VibeVoice — Long-form Multi-speaker TTS Docker image for Ray Serve
# Inherits from ray-base (torch + ray + flash-attn + common libs)
# Build:
#   podman build -f infra/docker/Dockerfile.vibevoice -t tech-noir/vibevoice:latest .
FROM tech-noir/ray-base:latest

# soundfile/scipy/transformers/accelerate already in base
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install diffusers

# Ray Serve project code
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY infra/k8s/serve_config.py /app/serve_config.py
WORKDIR /app
ENV PYTHONPATH=/app

ENV MODEL_PATH=/models/audio/vibevoice/VibeVoice-7B
