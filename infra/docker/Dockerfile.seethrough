# See-Through — Anime character layer decomposition Docker image
# Inherits from ray-base (torch + ray + flash-attn + common libs)
# Build:
#   podman build -f infra/docker/Dockerfile.seethrough -t tech-noir/seethrough:latest .
FROM tech-noir/ray-base:latest

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1

WORKDIR /opt
RUN git clone --depth 1 https://github.com/shitagaki-lab/see-through.git seethrough
WORKDIR /opt/seethrough

# Install deps — torch/fastapi/uvicorn already in base
RUN --mount=type=cache,target=/root/.cache/uv \
    grep -v -i -E '^(torch|torchvision|torchaudio|xformers|flash-attn|-e )' requirements.txt | \
    grep -v -E 'PyQt|qtpy|natsort|py7zr|ipykernel|Cython|pytest' > /tmp/reqs_fixed.txt && \
    uv pip install -r /tmp/reqs_fixed.txt || true && \
    uv pip install ./common ./annotators || true

COPY infra/docker/api_seethrough.py /opt/api.py

RUN mkdir -p /models/vision/see-through
ENV SEETHROUGH_MODEL_DIR=/models/vision/see-through HF_HOME=/models/.cache

# Ray Serve project code
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY infra/k8s/serve_config.py /app/serve_config.py
WORKDIR /app
ENV PYTHONPATH=/app

EXPOSE 8000
CMD ["python", "/opt/api.py"]
