# AniGen — Image-to-Rigged-3D Docker image for Ray Serve
# Inherits from ray-base (torch + ray + flash-attn + nvdiffrast)
# Build:
#   podman build -f infra/docker/Dockerfile.anigen -t tech-noir/anigen:latest .
FROM tech-noir/ray-base:latest

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    TORCH_CUDA_ARCH_LIST="8.9"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone AniGen
WORKDIR /opt
RUN git clone --recurse-submodules --depth 1 https://github.com/VAST-AI-Research/AniGen.git anigen
WORKDIR /opt/anigen

# pytorch3d — build from source (CUDA toolkit in base)
RUN --mount=type=cache,target=/root/.cache/uv \
    git clone --depth 1 https://github.com/facebookresearch/pytorch3d.git /tmp/pytorch3d && \
    cd /tmp/pytorch3d && \
    uv pip install --no-build-isolation . && \
    rm -rf /tmp/pytorch3d

# spconv — build from source (no cu124 pre-built wheel)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install spconv --no-build-isolation

# utils3d (git commit has utils3d.torch, PyPI 0.1.3 does not)
RUN git clone https://github.com/EasternJournalist/utils3d.git /opt/utils3d-src && \
    cd /opt/utils3d-src && git checkout 9a4eb15e4021b67b12c460c7057d642626897ec8 && \
    uv pip install . || true

# Core deps (torch/nvdiffrast already in base)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    transformers accelerate safetensors diffusers \
    einops matplotlib scipy opencv-python-headless \
    trimesh scikit-learn pandas h5py \
    huggingface-hub omegaconf rich rembg onnxruntime \
    easydict \
    gradio==4.44.1 gradio_litmodel3d==0.0.1 \
    pygltflib gguf geffnet igraph imageio imageio-ffmpeg \
    pymeshfix pyvista xatlas tqdm psutil ninja plyfile lpips rtree

ENV PYTHONPATH="/opt/anigen:/opt/utils3d-src"

# FastAPI wrapper
COPY infra/docker/api_anigen.py /opt/api.py

# Entrypoint: symlink models to expected location in AniGen working dir
COPY infra/docker/entrypoint_anigen.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh

RUN mkdir -p /models/3d/anigen/ckpts /models/.cache
ENV ANIGEN_MODEL_DIR=/models/3d/anigen/ckpts \
    HF_HOME=/models/.cache

# Ray Serve project code
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY infra/k8s/serve_config.py /app/serve_config.py
WORKDIR /app
ENV PYTHONPATH=/app

EXPOSE 8000
ENTRYPOINT ["/bin/bash", "/opt/entrypoint.sh"]
