# Dockerfile.native — Unified native serving container
# Single image for ALL models: Z-Image, FLUX, Anima, Wan, LTX, TRELLIS
# Based on SGLang's CUDA kernel stack — NO mmGP, NO Wan2GP
#
# Build:
#   podman build -f infra/docker/Dockerfile.native -t tech-noir/native:latest .

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

LABEL description="Unified native model serving — SGLang kernels + diffusers + transformers 4"

# ── System deps ────────────────────────────────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3-pip python3.10-dev python3.10-venv \
    git build-essential ninja-build cmake \
    ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# ── Python environment ─────────────────────────────────────────────────────────
RUN python3.10 -m pip install --upgrade pip uv
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1

# ── PyTorch (CUDA 12.8) ────────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch==2.10.0 torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu128

# ── SGLang kernels (sgl-kernel, flashinfer, cache-dit) ─────────────────────────
# These provide SageAttention, FlashAttention, optimized CUDA kernels
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install sglang-kernel flashinfer-python cache-dit

# ── SageAttention + FlashAttention ─────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install sageattention flash-attn --no-build-isolation || \
    echo "Attention kernels: using SGLang bundled versions"

# ── HuggingFace stack — PIN transformers to 4.x (NOT 5.x) ─────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    "transformers>=4.54.0,<5.0.0" \
    "diffusers>=0.37.0" \
    "accelerate>=1.10.0" \
    "peft>=0.15.0" \
    "safetensors" \
    "huggingface_hub" \
    "sentencepiece" \
    "tokenizers"

# ── Torchao (quantization + compile synergy) ───────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torchao

# ── GGUF support ───────────────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install gguf optimum-quanto || echo "GGUF/quanto: optional"

# ── Serving infrastructure ────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "ray[serve]>=2.43.0" httpx pyyaml pillow

# ── Audio/TTS support (for TTS models on same image) ──────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install soundfile scipy phonemizer faster-whisper || \
    echo "Audio deps: optional"

# ── 3D support (TRELLIS) ──────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install trimesh pygltflib plyfile || echo "3D deps: optional"

# ── Environment ───────────────────────────────────────────────────────────────
ENV SAFETENSORS_DISABLE_MMAP=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV HF_HOME=/models/hf_cache
ENV HF_HUB_CACHE=/models/hf_cache/hub
ENV PYTHONPATH=/app

# ── Application code ──────────────────────────────────────────────────────────
WORKDIR /app
COPY services/ /app/services/
COPY config/ /app/config/
COPY gateway/ /app/gateway/

# ── Entrypoint ────────────────────────────────────────────────────────────────
# Ray Serve worker — loads models on demand via native service
CMD ["python3", "-m", "ray", "start", "--address=${RAY_ADDRESS}", "--block", "--num-gpus=1"]
