# Dockerfile.native — Unified serving container
# Base: SGLang kernels (flashinfer, cache-dit)
# Model classes: diffusers (nn.Module ONLY, not pipelines)
# LTX: ltx-pipelines (Lightricks native)
# VRAM: custom BlockStreamHook
# NO mmGP. NO Wan2GP. NO SGLang serve.
#
# Build:
#   docker build -f infra/docker/Dockerfile.native -t forge-reg.local:30500/tech-noir/native:latest .

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

LABEL description="diffusers model classes + ltx-pipelines + SGLang kernels"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3-pip python3.10-dev \
    git build-essential ninja-build cmake \
    ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip uv
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1

# ── PyTorch 2.10 (CUDA 12.8) ──────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 \
    --index-url https://download.pytorch.org/whl/cu128

# ── flashinfer (SGLang attention kernels) ─────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install flashinfer-python

# ── cache-dit (step caching accelerator) ──────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install cache-dit

# ── transformers 4 PINNED + diffusers model classes + ltx-pipelines ──────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    "transformers>=4.54.0,<5.0.0" \
    "diffusers>=0.37.0" \
    ltx-pipelines ltx-core \
    peft accelerate safetensors \
    huggingface_hub sentencepiece tokenizers \
    gguf torchao bitsandbytes \
    "ray[serve]>=2.43.0" httpx pyyaml pillow av

# ── Fix torchaudio (ltx-pipelines pulls 2.11 which conflicts) ─────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torchaudio==2.10.0 --force-reinstall --no-deps

# ── Fix ltx_core circular import ──────────────────────────────────────────────
RUN python3 -c "
p = '/usr/local/lib/python3.10/dist-packages/ltx_core/loader/fuse_loras.py'
with open(p) as f: c = f.read()
c = c.replace(
    'from ltx_core.quantization.fp8_cast import calculate_weight_float8',
    '''try:\\n    from ltx_core.quantization.fp8_cast import calculate_weight_float8\\nexcept ImportError:\\n    def calculate_weight_float8(*a, **k):\\n        from ltx_core.quantization.fp8_cast import calculate_weight_float8 as f\\n        return f(*a, **k)'''
)
with open(p, 'w') as f: f.write(c)
print('Fixed ltx_core circular import')
"

# ── Environment ───────────────────────────────────────────────────────────────
ENV SAFETENSORS_DISABLE_MMAP=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV HF_HOME=/models/hf_cache
ENV HF_HUB_CACHE=/models/hf_cache/hub
ENV PYTHONPATH=/app

WORKDIR /app
COPY services/ /app/services/
COPY config/ /app/config/
COPY gateway/ /app/gateway/

CMD ["python3", "-m", "ray", "start", "--address=${RAY_ADDRESS}", "--block", "--num-gpus=1"]
