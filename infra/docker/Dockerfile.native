# Dockerfile.native — Unified serving container
# Base: SGLang (CUDA kernels, SageAttention, FlashAttention)
# Loading: transformers 4
# VRAM: custom hooks (BlockStreamHook)
# LTX: ltx-pipelines
# NO diffusers. NO mmGP. NO Wan2GP. NO SGLang serve.
#
# Build:
#   docker build -f infra/docker/Dockerfile.native -t forge-reg.local:30500/tech-noir/native:latest .

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

LABEL description="transformers 4 + custom VRAM + ltx-pipelines — NO diffusers"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# ── System ─────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3-pip python3.10-dev \
    git build-essential ninja-build cmake \
    ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip uv
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1

# ── PyTorch ────────────────────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu128

# ── SGLang (FULL install — pulls sgl-kernel, flashinfer, cache-dit, SageAttention) ──
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "sglang[diffusion]"

# ── Pin transformers to 4.x and PURGE diffusers ───────────────────────────────
# SGLang/cache-dit pull in transformers 5.x and diffusers — we don't want either
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "transformers>=4.54.0,<5.0.0" && \
    uv pip uninstall diffusers -y || true

# ── ltx-pipelines (Lightricks native — NOT diffusers) ──────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install ltx-pipelines ltx-core || \
    echo "ltx-pipelines: installing from GitHub" && \
    uv pip install "git+https://github.com/Lightricks/ltx-pipelines.git" || \
    echo "ltx-pipelines: will install at runtime"

# ── Supporting libraries (NO diffusers) ────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    peft accelerate safetensors \
    huggingface_hub sentencepiece tokenizers \
    gguf torchao \
    "ray[serve]>=2.43.0" httpx pyyaml pillow \
    aiosqlite sqlalchemy opencv-python-headless matplotlib sageattention comfyui-manager \
    scikit-image segment-anything piexif dill rotary-embedding-torch omegaconf

# ── ComfyUI custom node deps (ltx-video with --no-deps to avoid transformers/diffusers conflicts) ──
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps "ltx-video@git+https://github.com/Lightricks/LTX-Video@ltx-video-0.9.1" || \
    echo "ltx-video: will install at runtime"

# ── huggingface_hub compat shim (cached_download removed in 0.26+, aliased to hf_hub_download) ──
RUN echo 'import huggingface_hub; huggingface_hub.cached_download = huggingface_hub.hf_hub_download if not hasattr(huggingface_hub, "cached_download") else huggingface_hub.cached_download' \
    > /usr/local/lib/python3.10/dist-packages/zz_hf_compat.pth

# ── Environment ───────────────────────────────────────────────────────────────
ENV SAFETENSORS_DISABLE_MMAP=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV HF_HOME=/models/hf_cache
ENV HF_HUB_CACHE=/models/hf_cache/hub
ENV PYTHONPATH=/app
ENV LD_LIBRARY_PATH="/usr/local/lib/python3.10/dist-packages/nvidia/cu13/lib:/usr/local/lib/python3.10/dist-packages/nvidia/cuda_nvrtc/lib:${LD_LIBRARY_PATH}"

WORKDIR /app
COPY services/ /app/services/
COPY config/ /app/config/
COPY gateway/ /app/gateway/

CMD ["python3", "-m", "ray", "start", "--address=${RAY_ADDRESS}", "--block", "--num-gpus=1"]
