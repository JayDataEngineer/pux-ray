# Dockerfile.native — Standalone forge (no Ray, no K8s)
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04
LABEL description="Standalone forge — Pragmatic Extreme model serving"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3-pip python3.10-dev \
    git build-essential ninja-build cmake \
    ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m pip install --upgrade pip uv
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1

# ── PyTorch 2.10 (CUDA 12.8) ──────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 \
    --index-url https://download.pytorch.org/whl/cu128

# ── flashinfer + cache-dit (SGLang kernels) ────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install flashinfer-python cache-dit

# ── Core ML stack (NO ray) ────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    "transformers>=4.54.0,<5.0.0" \
    "diffusers>=0.37.0" \
    ltx-pipelines ltx-core \
    peft accelerate safetensors \
    huggingface_hub sentencepiece tokenizers \
    torchao bitsandbytes \
    "uvicorn[standard]" httpx pyyaml pillow starlette

# ── Fix torchaudio (ltx-pipelines pulls wrong version) ────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torchaudio==2.10.0 --force-reinstall --no-deps

# ── Fix ltx_core circular import ──────────────────────────────────────────────
COPY infra/docker/fix_ltx_import.py /tmp/fix_ltx_import.py
RUN python3 /tmp/fix_ltx_import.py

# ── Environment ───────────────────────────────────────────────────────────────
ENV SAFETENSORS_DISABLE_MMAP=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV HF_HOME=/models/hf_cache
ENV HF_HUB_CACHE=/models/hf_cache/hub
ENV PYTHONPATH=/app

WORKDIR /app
COPY services/ /app/services/
COPY config/ /app/config/
COPY gateway/ /app/gateway/

# ── Entrypoint: standalone forge ASGI server ──────────────────────────────────
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "services.standalone_forge:app", "--host", "0.0.0.0", "--port", "8000"]
