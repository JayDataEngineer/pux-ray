# ACE-STEP 1.5 — Text-to-Music Docker image for Ray Serve
# Inherits from ray-base (torch + ray + flash-attn + common libs)
# Build:
#   podman build -f infra/docker/Dockerfile.acestep -t tech-noir/acestep:latest .
FROM tech-noir/ray-base:latest

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1

WORKDIR /opt
RUN git clone --depth 1 https://github.com/ace-step/ACE-Step-1.5.git acestep
WORKDIR /opt/acestep

# Install deps — torch/fastapi/uvicorn already in base
RUN --mount=type=cache,target=/root/.cache/uv \
    grep -v -i -E '^(torch|torchvision|torchaudio|xformers|flash-attn)' requirements.txt > /tmp/reqs_filtered.txt && \
    uv pip install -r /tmp/reqs_filtered.txt || true

COPY infra/docker/api_acestep.py /opt/api.py

ENV ACESTEP_CHECKPOINTS_DIR=/models/audio/acestep \
    HF_HOME=/models/.cache

# Ray Serve project code
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY infra/k8s/serve_config.py /app/serve_config.py
WORKDIR /app
ENV PYTHONPATH=/app

EXPOSE 8000
CMD ["python", "/opt/api.py"]
