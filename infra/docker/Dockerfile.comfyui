# ComfyUI — Docker image for Ray Serve (flash-attn, extensions IaC-baked)
# ===========================================================================
# Build:
#   docker build -f infra/docker/Dockerfile.comfyui -t tech-noir/comfyui:latest .
#
# Base: ai-dock/ComfyUI (prebuilt: CUDA 12.x, torch, flash-attn, xformers, sageattention)
# Extensions cloned from config/comfyui_extensions.yaml during build (pure IaC).
# Models mounted at /models (read-only) from host at boot time.
# ComfyUI runs directly on port 18465 — health check hits ComfyUI's own root.
FROM ghcr.io/ai-dock/comfyui:latest-cuda

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1

# Clone ComfyUI extensions from our YAML config (IaC — baked into image)
COPY config/comfyui_extensions.yaml /tmp/extensions.yaml
COPY infra/docker/setup_comfyui.py /tmp/setup_comfyui.py
RUN python3 /tmp/setup_comfyui.py && rm /tmp/setup_comfyui.py /tmp/extensions.yaml
RUN pip install --no-cache-dir -r /opt/ComfyUI/requirements.txt 2>&1 | tail -1

EXPOSE 18465

# ComfyUI serves directly on 18465.
# Flash-attn + split-cross-attention enabled by default.
# Create model symlinks at runtime (models are host-mounted, not available during build)
CMD mkdir -p /opt/ComfyUI/models && \
    for d in HY-Motion RMBG sams ultralytics; do \
      [ -d /models/image-gen/comfyui/$d ] && [ ! -e /opt/ComfyUI/models/$d ] && \
        ln -s /models/image-gen/comfyui/$d /opt/ComfyUI/models/$d; \
    done; \
    cd /opt/ComfyUI && python3 main.py \
    --port 18465 \
    --listen 0.0.0.0 \
    --preview-method auto \
    --use-split-cross-attention
