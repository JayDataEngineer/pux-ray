# ComfyUI — Docker image for Ray Serve (thin layer on ray-base)
# Build:
#   podman build -f infra/docker/Dockerfile.comfyui -t tech-noir/comfyui:latest .
#
# Inherits from ray-base: CUDA 12.4 + PyTorch cu124 + ray + flash-attn + nvdiffrast + torchaudio
FROM tech-noir/ray-base:latest

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1

# System deps for ComfyUI
RUN apt-get update && apt-get install -y --no-install-recommends \
    git libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone ComfyUI
RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI

# Install ComfyUI Python deps — filter out torch/torchvision/torchaudio/xformers/flash-attn (in base)
RUN --mount=type=cache,target=/root/.cache/uv \
    grep -v -E "^(torch==|torchvision==|torchaudio|xformers|flash-attn)" \
        /opt/ComfyUI/requirements.txt > /tmp/req_filtered.txt && \
    uv pip install -r /tmp/req_filtered.txt && \
    rm /tmp/req_filtered.txt

# Clone ComfyUI extensions from our YAML config
COPY config/comfyui_extensions.yaml /tmp/extensions.yaml
COPY infra/docker/setup_comfyui.py /tmp/setup_comfyui.py
RUN python3 /tmp/setup_comfyui.py && rm /tmp/setup_comfyui.py /tmp/extensions.yaml

# Missing deps that custom nodes need but don't declare in ComfyUI's own requirements
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        opencv-python-headless \
        gguf \
        lark \
        numba \
        imageio-ffmpeg \
        av \
        scikit-image \
        mediapipe \
        onnxruntime \
        sentencepiece \
        peft \
        accelerate

# Ray Serve project code
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY infra/k8s/serve_config.py /app/serve_config.py
WORKDIR /app
ENV PYTHONPATH=/app

EXPOSE 18465
