# Tech Noir Wan2GP Unified Image
# Stage 1: builder (all deps via UV), Stage 2: runtime (copy + ray + code)
ARG CUDA_ARCHITECTURES="8.9"
ARG WAN2GP_BRANCH=main

# ─── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04 AS builder
ARG CUDA_ARCHITECTURES
ARG WAN2GP_BRANCH
ENV DEBIAN_FRONTEND=noninteractive TORCH_CUDA_ARCH_LIST="${CUDA_ARCHITECTURES}" FORCE_CUDA="1" MAX_JOBS="8"

RUN apt update && apt install -y python3 python3-pip git wget curl cmake ninja-build libgl1 libglib2.0-0 ffmpeg build-essential pkg-config libsndfile1 libsm6 libxext6 libxrender-dev libjpeg-dev libspatialindex-dev git-lfs espeak-ng mecab libmecab-dev sox libsox-dev libsox-fmt-all && apt clean

# UV for fast pip installs
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1 UV_PRERELEASE=allow

RUN git clone --depth 1 --branch ${WAN2GP_BRANCH} https://github.com/deepbeepmeep/Wan2GP.git /opt/wan2gp || echo "WARNING: clone failed"

# PyTorch (must use pip — UV doesn't support --index-url for torch+cu128)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch==2.10.0+cu128 torchvision==0.25.0+cu128 torchaudio==2.10.0+cu128 --index-url https://download.pytorch.org/whl/cu128

# Wan2GP requirements (filter torch, pip options, pin newer transformers)
RUN --mount=type=cache,target=/root/.cache/uv \
    grep -v -i -E '^(torch|torchvision|torchaudio|--|numpy==)' /opt/wan2gp/requirements.txt | \
    sed 's/transformers==.*/transformers>=4.54.0/' > /tmp/reqs_wan2gp.txt && \
    uv pip install -r /tmp/reqs_wan2gp.txt && rm /tmp/reqs_wan2gp.txt

# SageAttention (needs source build)
COPY infra/docker/patch_sageattention.py /tmp/patch_sageattention.py
RUN --mount=type=cache,target=/root/.cache/uv \
    python3 /tmp/patch_sageattention.py && \
    git clone https://github.com/thu-ml/SageAttention.git /tmp/sageattention && \
    cp /tmp/setup_patched.py /tmp/sageattention/setup.py && \
    cd /tmp/sageattention && uv pip install --no-build-isolation . && \
    rm -rf /tmp/sageattention /tmp/setup_patched.py /tmp/patch_sageattention.py

# mmgp + custom model deps
# Pin spacy explicitly (UV_PRERELEASE=allow can pull dev versions that fail to build)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "mmgp>=3.7.6" \
    faster-whisper kokoro "misaki[en]>=0.7,<0.9" "spacy>=3.7.1,<4.0.0" faster-qwen3-tts qwen-tts \
    scipy soundfile trimesh pyyaml scikit-image scikit-learn \
    pygltflib plyfile pyglet pyrr lpips pyvista pymeshfix xatlas rtree \
    geffnet igraph kornia onnxruntime mediapipe phonemizer sox backoff \
    datasets lark numba openai utils3d moderngl torchdiffeq opencv-python-headless

# spaCy model (can't install via uv — needs spacy download)
RUN python3 -m spacy download en_core_web_sm 2>/dev/null || pip install en_core_web_sm 2>/dev/null || echo "en_core_web_sm skipped"

# xformers (separate — may need specific CUDA version matching)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install xformers || echo "xformers skipped"

# VibeVoice (registers custom model_type with transformers — use pip with --no-deps to avoid downgrade)
RUN pip install vibevoice --no-deps 2>/dev/null || echo "vibevoice skipped"

# nvdiffrast + pytorch3d (source builds)
RUN --mount=type=cache,target=/root/.cache/uv \
    git clone --depth 1 https://github.com/NVlabs/nvdiffrast.git /tmp/nvdiffrast && \
    cd /tmp/nvdiffrast && uv pip install . --no-build-isolation && rm -rf /tmp/nvdiffrast
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-build-isolation "git+https://github.com/facebookresearch/pytorch3d.git@stable"
# Build spconv from source with CUDA extensions (SPCONV_DISABLE_JIT pre-compiles kernels)
# Must install cumm first (for pccm codegen), and mock nvidia-smi (GPU not available in builder).
# cumm's common.py calls nvidia-smi at import time to detect GPU architecture.
# Patch: add TensorViewBind from cumm into spconv.core_cc so that pybind11 can resolve
# the tv::Tensor type used as a default argument in GemmTunerSimple.run_with_tuned_result.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install cumm && \
    printf '#!/bin/bash\necho "NVIDIA GeForce RTX 4090"\n' > /usr/local/bin/nvidia-smi && chmod +x /usr/local/bin/nvidia-smi && \
    git clone --depth 1 --branch v2.3.8 --recursive https://github.com/traveller59/spconv.git /tmp/spconv && \
    cd /tmp/spconv && \
    python3 /tmp/patch_spconv.py && \
    SPCONV_DISABLE_JIT=1 uv pip install --no-build-isolation . && \
    rm -rf /tmp/spconv

# o-voxel (CUDA extension — must build in builder with torch available)
COPY vendor/o-voxel /tmp/o-voxel
RUN cd /tmp/o-voxel && pip install --no-build-isolation . && rm -rf /tmp/o-voxel

# Shim: redirect transformers.initialization to torch.nn.init (removed in transformers >=4.50)
COPY infra/docker/initialization_shim.py /usr/local/lib/python3.10/dist-packages/transformers/initialization.py

# ─── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONPATH=/opt/wan2gp:/opt/tech-noir WAN2GP_ROOT=/opt/wan2gp

RUN apt update && apt install -y python3 python3-pip libgl1 libglib2.0-0 ffmpeg libsndfile1 libsm6 libxext6 libxrender-dev libjpeg-dev libspatialindex-dev espeak-ng mecab libmecab-dev sox libsox-dev libsox-fmt-all && apt clean

# Copy ALL python packages from builder
COPY --from=builder /usr/local/lib/python3.10/dist-packages/ /usr/local/lib/python3.10/dist-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/
COPY --from=builder /opt/wan2gp /opt/wan2gp

# Ray (UV in runtime stage too)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "ray[serve]>=2.43.0"

COPY . /opt/tech-noir/
RUN useradd -u 1000 -ms /bin/bash user && mkdir -p /home/user/.cache && chown -R user:user /home/user/.cache /opt/tech-noir /opt/wan2gp
USER user
WORKDIR /opt/tech-noir
