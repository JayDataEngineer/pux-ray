# TRELLIS.2 Docker Worker
# Multi-stage build: compile CUDA extensions in devel image, run in runtime image
#
# Required extensions (compiled from source):
#   o_voxel, CuMesh, flash-attn, nvdiffrast, FlexGEMM, nvdiffrec
#
# Build:  docker build -f Dockerfile.trellis -t trellis-worker .
# Run:    docker run --gpus all -p 18401:18401 -v /models:/models:ro trellis-worker

# ---- Python Stage (provides Python 3.12 without deadsnakes PPA) ----
FROM python:3.12-slim-bookworm AS python-base

# ---- Build Stage ----
FROM nvidia/cuda:12.4.0-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# System deps for building extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential ninja-build \
    libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy Python 3.12 from the python-base stage
COPY --from=python-base /usr/local /usr/local
RUN ln -sf /usr/local/bin/python3.12 /usr/bin/python3.12 \
    && ln -sf /usr/local/bin/python3.12 /usr/bin/python \
    && ln -sf /usr/local/bin/pip3.12 /usr/bin/pip

# Install uv for fast pip
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /build

# Set CUDA arch for RTX 4090 (sm_89). Without this, torch can't auto-detect
# the GPU arch during docker build (no GPU visible at build time).
ENV TORCH_CUDA_ARCH_LIST="8.9"
ENV TORCH_NVCC_FLAGS="-Xfatbin -compress-all"

# Install torch + torchvision first (heavy, cacheable layer)
RUN uv pip install --system --no-cache \
    torch==2.6.0 torchvision==0.21.0 \
    --index-url https://download.pytorch.org/whl/cu124

# Install core Python deps (matches TRELLIS.2 setup.sh --basic)
RUN uv pip install --system --no-cache \
    imageio imageio-ffmpeg tqdm easydict ninja \
    opencv-python-headless trimesh transformers \
    gradio==6.0.1 tensorboard pandas lpips zstandard \
    kornia timm einops accelerate \
    pygltflib numpy soundfile \
    wheel setuptools packaging

# Build CUDA extensions one by one (cacheable layers)
# URLs match official TRELLIS.2 setup.sh

# 1. flash-attn (used by TRELLIS transformer backbone)
RUN uv pip install --system --no-cache flash-attn==2.7.3 --no-build-isolation

# 2. TRELLIS.2 source code + utils3d dependency (needed before o-voxel)
RUN git clone --depth 1 https://github.com/microsoft/TRELLIS.2.git /build/trellis \
    && cd /build/trellis \
    && uv pip install --system --no-cache \
        git+https://github.com/EasternJournalist/utils3d.git@9a4eb15e4021b67b12c460c7057d642626897ec8

# 3. o-voxel (bundled in TRELLIS.2 repo, not a standalone repo)
RUN cd /build/trellis \
    && cp -r o-voxel /tmp/o-voxel \
    && cd /tmp/o-voxel \
    && uv pip install --system --no-cache . --no-build-isolation \
    && rm -rf /tmp/o-voxel

# 4. nvdiffrast (differentiable rendering for texture baking, pinned to v0.4.0)
RUN git clone -b v0.4.0 --depth 1 https://github.com/NVlabs/nvdiffrast.git /tmp/nvdiffrast \
    && cd /tmp/nvdiffrast \
    && uv pip install --system --no-cache . --no-build-isolation \
    && rm -rf /tmp/nvdiffrast

# 5. CuMesh (CUDA mesh processing, needs --recursive for submodules)
RUN git clone --depth 1 --recursive https://github.com/JeffreyXiang/CuMesh.git /tmp/cumesh \
    && cd /tmp/cumesh \
    && uv pip install --system --no-cache . --no-build-isolation \
    && rm -rf /tmp/cumesh

# 6. FlexGEMM (flexible GEMM kernel, needs --recursive for submodules)
RUN git clone --depth 1 --recursive https://github.com/JeffreyXiang/FlexGEMM.git /tmp/flexgemm \
    && cd /tmp/flexgemm \
    && uv pip install --system --no-cache . --no-build-isolation \
    && rm -rf /tmp/flexgemm

# 7. nvdiffrec (JeffreyXiang fork with renderutils branch)
RUN git clone -b renderutils --depth 1 https://github.com/JeffreyXiang/nvdiffrec.git /tmp/nvdiffrec \
    && cd /tmp/nvdiffrec \
    && uv pip install --system --no-cache . --no-build-isolation \
    && rm -rf /tmp/nvdiffrec

# Apply DINOv3 model access fix (self.model.layer -> self.model.model.layer)
RUN sed -i 's/for i, layer_module in enumerate(self\.model\.layer):/for i, layer_module in enumerate(self.model.model.layer):/' \
    /build/trellis/trellis2/modules/image_feature_extractor.py

# ---- Runtime Stage ----
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy Python from builder (includes all compiled packages)
COPY --from=builder /usr/local /usr/local
RUN ln -sf /usr/local/bin/python3.12 /usr/bin/python3.12 \
    && ln -sf /usr/local/bin/python3.12 /usr/bin/python \
    && ldconfig

# Copy TRELLIS source from builder
COPY --from=builder /build/trellis /app/repo

# Install uv + fastapi + uvicorn for the HTTP server
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv pip install --system --no-cache fastapi uvicorn[standard] python-multipart soundfile httpx

WORKDIR /app

# Copy worker server code
COPY workers/ /app/workers/

ENV TOOL_NAME=trellis
ENV PORT=18401
ENV MODEL_PATH=/models/TRELLIS.2-4B
ENV PYTHONPATH=/app:/app/repo

EXPOSE 18401

CMD ["python", "-m", "workers.server"]
