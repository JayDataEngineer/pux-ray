# TRELLIS.2 — Image-to-3D Docker image for Ray Serve
# Inherits from ray-base (torch + ray + flash-attn + nvdiffrast + common libs)
# Build:
#   podman build -f infra/docker/Dockerfile.trellis -t tech-noir/trellis:latest .
FROM tech-noir/ray-base:latest

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    TORCH_CUDA_ARCH_LIST="8.9"

# Clone and install TRELLIS.2 from upstream
WORKDIR /opt
RUN git clone --recursive --depth 1 https://github.com/microsoft/TRELLIS.2.git trellis2
WORKDIR /opt/trellis2

# flexgemm — build from source
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install flexgemm --no-build-isolation || \
    git clone --depth 1 https://github.com/JeffreyXiang/FlexGEMM.git /tmp/flexgemm && \
    cd /tmp/flexgemm && \
    uv pip install --no-build-isolation . && \
    rm -rf /tmp/flexgemm

# o-voxel — build from source (from TRELLIS.2 submodule)
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /opt/trellis2 && \
    git submodule update --init --recursive o-voxel/third_party/eigen && \
    uv pip install --no-build-isolation -e o-voxel

# Unique deps (transformers/accelerate/fastapi already in base)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    safetensors diffusers \
    matplotlib opencv-python-headless \
    trimesh "imageio[ffmpeg]" pyglet pyrr \
    omegaconf rich

# FastAPI wrapper — receives image, returns GLB
COPY infra/docker/api_trellis.py /opt/api.py

RUN mkdir -p /models/3d/trellis
ENV TRELLIS_MODEL_DIR=/models/3d/trellis \
    HF_HOME=/models/.cache \
    PYTHONPATH=/opt/trellis2

EXPOSE 8000
CMD ["python", "/opt/api.py"]
