# MOSS-SoundEffect — Text-to-sound effect generation (8B params)
# Inherits from shared base (Python + torch + ray + flash-attn)
# Build:
#   podman build -f infra/docker/Dockerfile.moss-sfx -t tech-noir/moss-sfx:latest .
FROM tech-noir/ray-base:latest

ENV MOSS_SFX_MODEL_PATH=/models/audio/moss-soundeffect \
    HF_HOME=/models/.cache
