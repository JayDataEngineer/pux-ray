# HY-Motion 1.0 — Text-to-3D Human Motion Docker image for Ray Serve
# Inherits from shared base (Python 3.13 + torch + ray + flash-attn)
# Build:
#   docker build -f infra/docker/Dockerfile.hymotion -t tech-noir/hymotion:latest .
FROM tech-noir/ray-base:latest

RUN apt-get update && apt-get install -y --no-install-recommends git-lfs && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/Tencent-Hunyuan/HY-Motion-1.0.git /opt/hymotion
WORKDIR /opt/hymotion

RUN git lfs pull

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    torchdiffeq accelerate diffusers einops safetensors \
    scipy transforms3d PyYAML omegaconf click \
    fastapi "uvicorn[standard]" python-multipart openai

COPY infra/docker/api_hymotion.py /opt/api.py

# Ray Serve project code
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY infra/k8s/serve_config.py /app/serve_config.py
WORKDIR /app

ENV PYTHONPATH=/app:/opt/hymotion \
    HF_HOME=/root/.cache/huggingface \
    USE_HF_MODELS=1

EXPOSE 8000
CMD ["python", "/opt/api.py"]
