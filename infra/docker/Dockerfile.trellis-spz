# TRELLIS.2 StableProjectorz — VRAM-optimized Image-to-3D Docker image
# Inherits from shared base (Python 3.12 + torch + ray + flash-attn + nvdiffrast)
# Build:
#   podman build -f infra/docker/Dockerfile.trellis-spz -t tech-noir/trellis-spz:latest .
FROM tech-noir/ray-base:latest

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST="8.9" \
    MAX_JOBS=2

# Build deps for compiled extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake ninja-build \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    libjpeg-dev libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone repo with submodules (flexicubes, eigen for o-voxel)
RUN git clone --recurse-submodules --depth 1 \
    https://github.com/IgorAherne/TRELLIS.2-stableprojectorz.git /opt/trellis
WORKDIR /opt/trellis

# Core Python deps
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
    imageio imageio-ffmpeg tqdm easydict opencv-python-headless \
    ninja trimesh numpy scipy \
    tensorboard pandas lpips zstandard \
    pillow-simd kornia timm \
    huggingface-hub plyfile

# utils3d — pinned commit for trellis2 compatibility
RUN git clone https://github.com/EasternJournalist/utils3d.git /opt/utils3d && \
    cd /opt/utils3d && \
    git checkout 9a4eb15e4021b67b12c460c7057d642626897ec8

# nvdiffrec (PBR rendering)
RUN git clone -b renderutils --depth 1 \
        https://github.com/JeffreyXiang/nvdiffrec.git /tmp/extensions/nvdiffrec && \
    env TORCH_CUDA_ARCH_LIST="8.9" \
        uv pip install /tmp/extensions/nvdiffrec --no-build-isolation && \
    rm -rf /tmp/extensions/nvdiffrec

# flex_gemm — download source, patch triton 3.x incompatibilities, install patched.
COPY infra/docker/patch_flex_gemm.py /tmp/patch_flex_gemm.py
RUN git clone --depth 1 https://github.com/JeffreyXiang/FlexGEMM.git /tmp/flex_gemm && \
    python /tmp/patch_flex_gemm.py /tmp/flex_gemm && \
    uv pip install /tmp/flex_gemm --no-build-isolation && \
    rm -rf /tmp/flex_gemm /tmp/patch_flex_gemm.py

# CuMesh — compiled from source (CUDA mesh operations: BVH, remeshing, simplification)
RUN git clone --recursive https://github.com/JeffreyXiang/CuMesh.git /tmp/CuMesh && \
    env TORCH_CUDA_ARCH_LIST="8.9" \
        uv pip install /tmp/CuMesh --no-build-isolation && \
    rm -rf /tmp/CuMesh

# o-voxel — built from source with lazy flex_gemm/cumesh imports
COPY infra/docker/patch_ovoxel.py /tmp/patch_ovoxel.py
RUN cd /opt/trellis && \
    git submodule update --init --recursive o-voxel/third_party/eigen && \
    python /tmp/patch_ovoxel.py && \
    uv pip install o-voxel/ --no-build-isolation && \
    rm /tmp/patch_ovoxel.py

# Patch trellis2 base.py — lazy cumesh/flex_gemm imports
COPY infra/docker/patch_trellis2.py /tmp/patch_trellis2.py
RUN python /tmp/patch_trellis2.py && rm /tmp/patch_trellis2.py

ENV ATTN_BACKEND=xformers \
    HF_HOME=/root/.cache/huggingface \
    PYTHONPATH=/opt/trellis:/opt/utils3d

# Startup script (applies runtime patches, then starts API)
COPY infra/docker/start_trellis.sh /opt/start.sh
COPY infra/docker/patch_birefnet_runtime.py /opt/patch_birefnet_runtime.py
COPY infra/docker/patch_dinov3_runtime.py /opt/patch_dinov3_runtime.py
COPY infra/docker/patch_conv_flex_gemm.py /opt/patch_conv_flex_gemm.py
COPY infra/docker/patch_cumesh_fallback.py /opt/patch_cumesh_fallback.py
RUN chmod +x /opt/start.sh

# Ray Serve project code
COPY services/ /app/services/
COPY gateway/ /app/gateway/
COPY registry/ /app/registry/
COPY infra/k8s/serve_config.py /app/serve_config.py
WORKDIR /app
ENV PYTHONPATH=/app:/opt/trellis:/opt/utils3d

EXPOSE 8000
CMD ["/opt/start.sh"]
