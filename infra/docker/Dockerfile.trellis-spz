# TRELLIS StableProjectorz — VRAM-optimized (8GB) Image-to-3D Docker image
# =============================================================================
# Fork: https://github.com/IgorAherne/trellis-stable-projectorz
# Optimizations: float16 (vs float32), int32 (vs int64) — fits in 8GB VRAM
#
# Build:
#   docker build -f infra/docker/Dockerfile.trellis-spz -t tech-noir/trellis-spz:latest .
#
# Models: jetx/TRELLIS-image-large loaded from /models (host-mounted at runtime)
FROM nvidia/cuda:12.1.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3.11-venv python3-pip \
    build-essential git cmake \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender-dev \
    libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

RUN git clone --recurse-submodules --depth 1 \
    https://github.com/IgorAherne/trellis-stable-projectorz.git /opt/trellis
WORKDIR /opt/trellis

# Install torch + torchvision (cu121 — original TRELLIS CUDA version)
RUN pip install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu121

# Install Python deps (filter Windows-only packages AND kaolin placeholder)
RUN grep -v 'pywin32\|pyreadline3\|^kaolin' requirements.txt > /tmp/reqs_linux.txt && \
    pip install --no-cache-dir -r /tmp/reqs_linux.txt

# Flash-attention and API deps
RUN pip install --no-cache-dir flash-attn --no-build-isolation || \
    pip install --no-cache-dir xformers

# Compiled CUDA extensions and 3D libraries
RUN pip install --no-cache-dir utils3d || true
# Patch: kaolin placeholder blocks import — replace with no-op (check_tensor is a validation util)
RUN sed -i 's/from kaolin.utils.testing import check_tensor/def check_tensor(*a,**k): return True/' \
    /opt/trellis/trellis/representations/mesh/flexicubes/flexicubes.py
RUN pip install --no-cache-dir nvdiffrast || true
RUN pip install --no-cache-dir spconv-cu121 || pip install --no-cache-dir spconv || true

RUN pip install --no-cache-dir fastapi "uvicorn[standard]" python-multipart

COPY infra/docker/api_trellis_spz.py /opt/api.py

ENV ATTN_BACKEND=flash-attn \
    SPCONV_ALGO=native \
    HF_HOME=/tmp/hf_cache

EXPOSE 8000
CMD ["python", "/opt/api.py"]
