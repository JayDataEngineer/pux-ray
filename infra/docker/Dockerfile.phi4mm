# Phi-4-multimodal-instruct — Omni model (text + vision + speech → text)
# Inherits from shared base (Python + torch + ray + flash-attn)
# Build:
#   podman build -f infra/docker/Dockerfile.phi4mm -t tech-noir/phi4mm:latest .
FROM tech-noir/ray-base:latest

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install backoff peft torchvision

ENV PHI4MM_MODEL_PATH=/models/multimodal/phi4-multimodal-instruct \
    HF_HOME=/models/.cache
