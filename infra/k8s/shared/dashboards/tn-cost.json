{
  "title": "Tech Noir Cost Analytics",
  "uid": "tn-cost",
  "version": 1,
  "tags": ["tech-noir", "cost"],
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "Total GPU Cost (7d)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{
        "expr": "sum(increase(tn_gpu_seconds_total[7d])) * 0.3 / 3600",
        "legendFormat": "GPU Cost"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {"mode": "fixed"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red"}]}
        }
      }
    },
    {
      "title": "Total GPU Hours (7d)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{
        "expr": "sum(increase(tn_gpu_seconds_total[7d])) / 3600",
        "legendFormat": "GPU Hours"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "duration(h)",
          "decimals": 2
        }
      }
    },
    {
      "title": "Avg Margin %",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{
        "expr": "sum(increase(tn_margin_usd_total[7d])) / sum(increase(tn_revenue_usd_total[7d])) * 100",
        "legendFormat": "Margin %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"value": null, "color": "red"},
            {"value": 30, "color": "yellow"},
            {"value": 60, "color": "green"}
          ]}
        }
      }
    },
    {
      "title": "Revenue vs Cost (7d)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(increase(tn_revenue_usd_total[7d]))", "legendFormat": "Revenue"},
        {"expr": "sum(increase(tn_gpu_seconds_total[7d])) * 0.3 / 3600", "legendFormat": "Cost"}
      ]
    },
    {
      "title": "GPU Seconds by Service (7d)",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4},
      "targets": [{
        "expr": "sum by(service_id) (increase(tn_gpu_seconds_total[7d]))",
        "legendFormat": "{{service_id}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "GPU Seconds by Model",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4},
      "targets": [{
        "expr": "sum by(gpu_model) (increase(tn_gpu_seconds_total[7d]))",
        "legendFormat": "{{gpu_model}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Cost per Service (7d)",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4},
      "targets": [{
        "expr": "sum by(service_id) (increase(tn_gpu_seconds_total[7d])) * 0.3 / 3600",
        "legendFormat": "{{service_id}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "GPU Trend (30d)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{
        "expr": "sum by(service_id) (rate(tn_gpu_seconds_total[1h]))",
        "legendFormat": "{{service_id}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Margin Trend (30d)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "rate(tn_revenue_usd_total[1h])", "legendFormat": "Revenue"},
        {"expr": "rate(tn_gpu_seconds_total[1h]) * 0.3 / 3600", "legendFormat": "GPU Cost"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {"mode": "palette-classic"}
        }
      }
    }
  ]
}
