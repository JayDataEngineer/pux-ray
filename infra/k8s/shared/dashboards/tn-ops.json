{
  "title": "Tech Noir Operations",
  "uid": "tn-ops",
  "version": 1,
  "tags": ["tech-noir", "operations"],
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "rate(http_requests_total{job=\"tech-noir-webapp\"}[5m])", "legendFormat": "{{handler}} {{method}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "P99 Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"tech-noir-webapp\"}[5m])) by(le, handler))", "legendFormat": "{{handler}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "API Latency by Service (p50)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [{
        "expr": "histogram_quantile(0.50, sum(rate(tn_api_duration_seconds_bucket[5m])) by(le, service_id))",
        "legendFormat": "{{service_id}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "API Latency by Service (p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(tn_api_duration_seconds_bucket[5m])) by(le, service_id))",
        "legendFormat": "{{service_id}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [{
        "expr": "sum(rate(http_requests_total{job=\"tech-noir-webapp\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"tech-noir-webapp\"}[5m])) * 100",
        "legendFormat": "Error %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {"mode": "absolute", "steps": [
            {"value": null, "color": "green"},
            {"value": 1, "color": "yellow"},
            {"value": 5, "color": "red"}
          ]}
        }
      }
    },
    {
      "title": "Jobs In Progress",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 16},
      "targets": [{
        "expr": "sum(tn_jobs_in_progress)",
        "legendFormat": "In Progress"
      }]
    },
    {
      "title": "Jobs In Progress by Service",
      "type": "barchart",
      "gridPos": {"h": 6, "w": 8, "x": 4, "y": 16},
      "targets": [{
        "expr": "sum by(service_id) (tn_jobs_in_progress)",
        "legendFormat": "{{service_id}}"
      }]
    },
    {
      "title": "Job Queue Rate (queued vs completed)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "rate(tn_jobs_total{status=\"queued\"}[5m])", "legendFormat": "Queued"},
        {"expr": "rate(tn_jobs_total{status=\"completed\"}[5m])", "legendFormat": "Completed"},
        {"expr": "rate(tn_jobs_total{status=\"failed\"}[5m])", "legendFormat": "Failed"}
      ]
    }
  ]
}
