[Unit]
Description=ComfyUI Extension Auto-Update Sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=user
ExecStart=/home/user/Documents/programs/ray/scripts/sidecar_comfyui_extensions.sh
StandardOutput=append:/tmp/tech-noir/comfyui-sidecar.log
StandardError=append:/tmp/tech-noir/comfyui-sidecar.log

[Install]
WantedBy=multi-user.target
