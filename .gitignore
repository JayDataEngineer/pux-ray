# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ray
.ray_tmp/
/tmp/ray/

# Local config (contains machine-specific paths and secrets)
config/local.yaml
config/secrets.env
config/age.key
!config/secrets.env.example

# Infrastructure env files (contain secrets)
infra/*.env
!infra/*.env.example

# Infisical secret values (managed via CLI, not files)
# The infisical-secrets Secret in infisical.yaml should have empty values
# Set real values via: task secrets:set KEY=VALUE

# Cloned vendor repos (upstream code, never edited)
vendor/
stats

# Build artifacts (compiled extensions, cached builds)
infra/build/

# Cloned repos (managed by git-sync in docker compose)
infra/repos/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Models (managed by ray-noir CLI, not git)
# Models live in MODELS_ROOT, not in this repo
sdk/models/

# Logs
logs/

# Misc
info/

# Lock file (optional - uncomment if you want to pin deps)
# uv.lock
llama-server-upstream

# Personal docs
USAGE.md

# Reference/learning repos
learn/
